# ===== LLM 配置（OpenAI 兼容接口）=====
# 这一组是可选的：也可以留空，启动后在网页「设置 · AI 接口」里
# 保存多套配置并随时切换。这里的配置会作为只读项出现在列表中。
#
# 完整地址，或只填到 /v1（服务端会自动补 /chat/completions）
LLM_API_BASE=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# 额外请求参数（JSON，可留空）。例如关闭思考模式：
# LLM_EXTRA_PARAMS={"top_p":0.95}

# ===== 服务 =====
PORT=3001
DATA_DIR=/data
